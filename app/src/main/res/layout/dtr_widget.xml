<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/glass_widget_background">

    <!-- Top Row: Title and Logo text -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AURA DTR"
            android:textColor="#FF14B8A6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLOCKED OUT"
            android:textColor="#FFEF4444"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@android:drawable/editbox_dropdown_light_frame"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Center Content: Attendance Status & Log details -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/widget_header"
        android:layout_above="@+id/widget_button"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Clocked Out"
            android:textColor="#E0FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_hours_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today: 0h 0m worked"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Bottom Row: Deep-link action button -->
    <TextView
        android:id="@+id/widget_button"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="OPEN AURA DTR"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/widget_button_background"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
